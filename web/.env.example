# From your Supabase project: Settings → API (or `supabase status` when running locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only, never exposed to the browser: used to sign in with a username
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
