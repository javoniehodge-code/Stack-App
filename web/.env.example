# From your Supabase project: Settings → API (or `supabase status` when running locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only, never exposed to the browser: lets Stack's sign-in routes ask the database which saved address owns
# a Gmail inbox (resolve_sign_in_email). Its SHA-256 hash goes in private.server_tokens; see docs/gmail-aliases-rollout.md.
SIGN_IN_RESOLVER_TOKEN=a-long-random-string
